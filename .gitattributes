* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Audio fixtures and databases are binary: never touch their bytes.
*.mp3 binary
*.m4a binary
*.aiff binary
*.aif binary
*.wav binary
*.flac binary
*.ogg binary
*.sqlite binary
